      <div class="hinweise" id="entwurfHinweise" hidden></div>
      <h3>Zum Beispiel</h3>
      <div class="ideen" id="ideen"></div>
      <details class="dna">
        <summary>Was das Studio über das Haus weiss</summary>
        <div id="dna"></div>
      </details>
    </section>

    <section class="tab" data-tab="vorlagen">
